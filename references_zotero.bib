@article{luxman_benchmark_2023,
	title = {A {Benchmark} {Dataset} and {Evaluation} for {Best} {Light} {Configuration} in {Reflectance} {Transformation} {Imaging}},
	volume = {20},
	issn = {2161-8798},
	url = {https://library.imaging.org/archiving/articles/20/1/15},
	doi = {10.2352/issn.2168-3204.2023.20.1.15},
	abstract = {Abstract Reflectance Transformation Imaging (RTI) is a non-invasive technique that enables the analysis of materials. Recent advancements in this technology, along with the availability of software for surface analysis through relighting, have improved the restoration and conservation of cultural heritage objects. However, there is a lack of appropriate benchmark data and reference light configurations, which makes it difficult to quantitatively compare and evaluate RTI data acquisitions. To address this, we have developed a dataset that can be used to assess the effectiveness of different surface light configurations for RTI acquisition. Additionally, we introduce methods to derive an ideal reference light configuration for a surface from its dense RTI acquisition. This dataset provides a standardized set of dense RTI acquisitions, accompanied by their corresponding reference light configurations that were obtained using our methods. This dataset can help researchers and developers to compare the performance of their approaches in solving the "Next Best Light Position" problem in RTI acquisition, which can ultimately improve the accuracy and efficiency of RTI acquisition and broaden its applicability in various fields.},
	language = {en},
	urldate = {2025-10-27},
	journal = {Archiving Conference},
	publisher = {Society for Imaging Science and Technology},
	author = {Luxman, Ramamoorthy and Chatoux, Hermine and Goïc, Gaëtan Le and Hardeberg, Jon Yngve and Marzani, Franck and Mansouri, Alamin and Chatoux, Hermine and Goïc, Gaëtan Le and Hardeberg, Jon Yngve and Marzani, Franck and Mansouri, Alamin},
	month = jun,
	year = {2023},
	pages = {75--81},
}

@inproceedings{righetto_enhancing_2025,
	title = {Enhancing manuscript analysis with reflectance transformation imaging: a user study on interactive visualization options},
	volume = {13569},
	shorttitle = {Enhancing manuscript analysis with reflectance transformation imaging},
	url = {https://www.spiedigitallibrary.org/conference-proceedings-of-spie/13569/135690L/Enhancing-manuscript-analysis-with-reflectance-transformation-imaging--a-user/10.1117/12.3062630.full},
	doi = {10.1117/12.3062630},
	abstract = {Reflectance Transformation Imaging (RTI) is a well-established technique to improve the visualization of cultural heritage objects. Recent advancements have been achieved from the technical point of view, with novel interpolation techniques improving the quality of reconstructed highlights and shadows and algorithms for feature enhancement. The effectiveness of the relighting and enhancement methods proposed is, however, difficult to assess in practice, as it requires experts’ feedback on domain-specific data. This work aims at providing hints on the optimization of the effectiveness of the use of RTI for studying palimpsests, i.e., old documents in which writing has been removed, covered, or replaced by new writing. Leveraging a custom web visualization tool developed with an open-source library, we performed a user evaluation with field experts. We compared three relighting models differing in the ability to reproduce highfrequency effects and shadows and a series of image processing tools designed to enhance the visualization experience. We collected experts’ feedback with a properly designed questionnaire, including ratings of the usefulness of the techniques for the specific task and generic questions on user preferences. The survey highlighted that an application allowing image processing and relighting within the same interface is considered very important for the study of manuscripts. It is important to consider user feedback, as their interests and field of study guide their attention to specific features. Therefore, applications that allow users to choose between different relighting algorithms might be the most effective approach.},
	urldate = {2025-10-27},
	booktitle = {Optics for {Arts}, {Architecture}, and {Archaeology} ({O3A}) {X}},
	publisher = {SPIE},
	author = {Righetto, L. and Marchioro, G. and Giachetti, A.},
	month = aug,
	year = {2025},
	pages = {101--111},
}

