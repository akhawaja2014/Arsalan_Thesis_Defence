@book{ruffoni_viking_2013,
	address = {Saarbrücken},
	title = {Viking {Age} {Queens}: {The} {Example} of {Oseberg}},
	isbn = {978-3-659-30638-9},
	shorttitle = {Viking {Age} {Queens}},
	abstract = {The Oseberg burial has been studied extensively and many scholars have argued that it is the richest female burial in Europe and that, therefore, it must be much more than the burial of a secular ruler. The women buried in the mound must have occupied a social position of the highest importance, probably being sorceresses, priestesses or demigoddesses. Througout my thesis I have compared Oseberg to many other Iron Age and Viking Age burials. I have also looked at the legal rights of women in Scandinavia and on the Continent. From the gathered evidence I have argued that the Osberg burial is not unparalleled in richness and that it is not impossible for a woman to have been a powerful ruler in the early Viking Age. I have strengthened my argument with literary evidence for historical female figures who ruled kingdoms alone for periods of their lifetime.},
	language = {English},
	publisher = {LAP LAMBERT Academic Publishing},
	author = {Ruffoni, Kirsten},
	year = {2013},
}

